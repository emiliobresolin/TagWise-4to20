TAGWISE_DEPLOYMENT_ENV=development
TAGWISE_NODE_ENV=development
# 0.0.0.0 exposes the API on the LAN so a phone on the same network can reach
# it; use 127.0.0.1 to keep it local-only.
TAGWISE_HOST=0.0.0.0
TAGWISE_API_PORT=4100
TAGWISE_WORKER_PORT=4101
TAGWISE_DATABASE_URL=postgres://tagwise:tagwise@127.0.0.1:5432/tagwise
TAGWISE_STORAGE_BUCKET=tagwise-evidence-dev
TAGWISE_STORAGE_REGION=us-east-1
TAGWISE_STORAGE_ENDPOINT=http://127.0.0.1:9000
# TAGWISE_STORAGE_PUBLIC_ENDPOINT: endpoint embedded in the presigned URLs the
# phone consumes for photo upload/download. It MUST be this PC's LAN IP
# (reachable from the phone) — 127.0.0.1 would point the phone at itself.
# PLACEHOLDER: replace 192.168.0.100 with the real LAN IP (run `ipconfig`)
# before the demo. Internal S3 operations keep using TAGWISE_STORAGE_ENDPOINT.
# Optional: when omitted it defaults to TAGWISE_STORAGE_ENDPOINT.
TAGWISE_STORAGE_PUBLIC_ENDPOINT=http://192.168.0.100:9000
TAGWISE_STORAGE_ACCESS_KEY_ID=minioadmin
TAGWISE_STORAGE_SECRET_ACCESS_KEY=minioadmin
TAGWISE_STORAGE_FORCE_PATH_STYLE=true
TAGWISE_STORAGE_AUTO_CREATE_BUCKET=true
TAGWISE_AUTH_TOKEN_SECRET=replace-me-in-real-environments
TAGWISE_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
TAGWISE_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
TAGWISE_AI_ENABLED=false
# TAGWISE_AI_PROVIDER: 'openai' calls the real OpenAI API (needs internet +
# OPENAI_API_KEY). Use 'mock' for offline demos — deterministic AI diagnosis
# without any external call.
TAGWISE_AI_PROVIDER=mock
TAGWISE_AI_REQUEST_TIMEOUT_MS=30000
# Required only when TAGWISE_AI_ENABLED=true and TAGWISE_AI_PROVIDER=openai.
# Never commit a real key — set it only in your local .env.
OPENAI_API_KEY=<your-openai-api-key>
OPENAI_MODEL=gpt-4o
TAGWISE_SEED_TECHNICIAN_EMAIL=tech@tagwise.local
TAGWISE_SEED_TECHNICIAN_PASSWORD=TagWise123!
TAGWISE_SEED_TECHNICIAN_DISPLAY_NAME=Field Technician
TAGWISE_SEED_SUPERVISOR_EMAIL=supervisor@tagwise.local
TAGWISE_SEED_SUPERVISOR_PASSWORD=TagWise123!
TAGWISE_SEED_SUPERVISOR_DISPLAY_NAME=Field Supervisor
TAGWISE_SEED_MANAGER_EMAIL=manager@tagwise.local
TAGWISE_SEED_MANAGER_PASSWORD=TagWise123!
TAGWISE_SEED_MANAGER_DISPLAY_NAME=Operations Manager
