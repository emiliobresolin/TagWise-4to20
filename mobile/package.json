{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:android:preview": "node scripts/check-env.js && npx eas-cli build --platform android --profile preview",
    "eas-build-pre-install": "node scripts/check-env.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "expo": "~54.0.34",
    "expo-camera": "~17.0.10",
    "expo-file-system": "~19.0.22",
    "expo-image-picker": "~17.0.11",
    "expo-secure-store": "~15.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "i18next": "^26.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^17.0.8",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  },
  "private": true
}
